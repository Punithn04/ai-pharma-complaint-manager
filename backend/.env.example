# ---- Groq (LLM provider) ----
# Create a free API token at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Model used for extraction + risk reasoning (needs to be reliable at JSON)
GROQ_EXTRACTION_MODEL=llama-3.3-70b-versatile
# Small/fast model used for intent routing (cheap hops).
# NOTE: gemma2-9b-it (named in the assignment) was decommissioned by Groq;
# llama-3.1-8b-instant is the current small/fast equivalent.
GROQ_FAST_MODEL=llama-3.1-8b-instant

# ---- Database ----
# Production (mandatory stack): Postgres or MySQL
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/aivoa_complaints
# For zero-setup local dev you may instead use SQLite:
# DATABASE_URL=sqlite:///./complaints.db

# ---- CORS ----
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
